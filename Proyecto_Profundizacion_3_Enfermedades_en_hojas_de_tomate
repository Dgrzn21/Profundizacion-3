        "# 4. Entrenar la Línea Base Estricta (Regresión Logística)\n",
        "print(\"\\nEntrenando modelo de Regresión Logística (Línea Base)...\")\n",
        "clf = LogisticRegression(max_iter=1000, random_state=42, n_jobs=-1)\n",
