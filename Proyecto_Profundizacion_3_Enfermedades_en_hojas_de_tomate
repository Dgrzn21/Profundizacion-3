        "import os\n",
        "import cv2\n",
        "import numpy as np\n",
        "from skimage.feature import local_binary_pattern\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import classification_report, confusion_matrix\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Parámetros para LBP (Textura)\n",
        "radius = 3\n",
        "n_points = 8 * radius\n",
        "METHOD = 'uniform'\n",
        "\n",
        "def extraer_textura_lbp(imagen_path):\n",
        "    img = cv2.imread(imagen_path, cv2.IMREAD_GRAYSCALE)\n",
        "    if img is None:\n",
        "        return None\n",
        "    img = cv2.resize(img, (128, 128))\n",
        "    lbp = local_binary_pattern(img, n_points, radius, METHOD)\n",
        "    n_bins = int(lbp.max() + 1)\n",
        "    hist, _ = np.histogram(lbp.ravel(), bins=n_bins, range=(0, n_bins), density=True)\n",
        "    return hist\n",
        "\n",
        "def cargar_dataset_lbp(base_dir):\n",
        "    features = []\n",
        "    labels = []\n",
        "    classes = sorted(os.listdir(base_dir))\n",
        "    for cls in classes:\n",
        "        cls_path = os.path.join(base_dir, cls)\n",
        "        if not os.path.isdir(cls_path):\n",
        "            continue\n",
        "        print(f\"Procesando textura LBP para: {cls}...\")\n",
        "        for img_name in os.listdir(cls_path):\n",
        "            img_path = os.path.join(cls_path, img_name)\n",
        "            hist = extraer_textura_lbp(img_path)\n",
        "            if hist is not None:\n",
        "                features.append(hist)\n",
        "                labels.append(cls)\n",
        "    return np.array(features), np.array(labels)\n",
        "\n",
        "# 2. Cargar datos de Train y Test\n",
        "train_dir = 'dataset_tomato/Dataset/train'\n",
        "test_dir = 'dataset_tomato/Dataset/test'\n",
        "\n",
        "X_train_lbp, y_train_lbp = cargar_dataset_lbp(train_dir)\n",
        "X_test_lbp, y_test_lbp = cargar_dataset_lbp(test_dir)\n",
        "\n",
        "# 3. Entrenar el modelo con Textura\n",
        "print(\"\\nEntrenando Regresión Logística con características de textura (LBP)...\")\n",
        "clf_texture = LogisticRegression(max_iter=1000)\n",
        "clf_texture.fit(X_train_lbp, y_train_lbp)\n",
        "\n",
        "# 4. Predicciones y Evaluación\n",
        "y_pred_lbp = clf_texture.predict(X_test_lbp)\n",
        "classes = sorted(os.listdir(train_dir))\n",
        "\n",
        "print(\"\\n--- REPORTE DE CLASIFICACIÓN (TEXTURA LBP) ---\")\n",
        "print(classification_report(y_test_lbp, y_pred_lbp))\n",
        "\n",
        "# 5. Graficar Matriz de Confusión con estilo 'rocket'\n",
        "plt.figure(figsize=(10, 8))\n",
        "cm = confusion_matrix(y_test_lbp, y_pred_lbp, labels=classes)\n",
        "\n",
        "sns.heatmap(\n",
        "    cm,\n",
        "    annot=True,\n",
        "    fmt='d',\n",
        "    cmap='rocket',\n",
        "    xticklabels=[c.replace('Tomato___', '') for c in classes],\n",
        "    yticklabels=[c.replace('Tomato___', '') for c in classes]\n",
        ")\n",
        "\n",
        "plt.title('Matriz de Confusión - Baseline Textura LBP + Regresión Logística', fontsize=12, fontweight='bold')\n",
        "plt.xlabel('Predicción del Modelo', fontsize=10)\n",
        "plt.ylabel('Valor Real (Ground Truth)', fontsize=10)\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.yticks(rotation=0)\n",
        "plt.tight_layout()\n",
        "plt.show()"
